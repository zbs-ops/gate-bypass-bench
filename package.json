{
  "name": "gate-bypass-bench",
  "version": "0.5.0",
  "description": "A benchmark that measures how often AI-agent command gates can be bypassed, by rewriting a forbidden command and counting a bypass only when the forbidden effect actually happens in a sandbox.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "gate-bypass-bench": "dist/cli.js"
  },
  "scripts": {
    "bench": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
