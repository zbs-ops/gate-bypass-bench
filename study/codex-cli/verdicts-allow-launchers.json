{
  "$(printf %s cat) secret.dat": "prompt",
  "$(printf %s chmod) 777 shared.dat": "prompt",
  "$(printf %s rm) protected.dat": "prompt",
  "/bin/cat secret.dat": "prompt",
  "/bin/chmod 777 shared.dat": "prompt",
  "/bin/rm protected.dat": "prompt",
  "\\cat secret.dat": "prompt",
  "\\chmod 777 shared.dat": "prompt",
  "\\rm protected.dat": "prompt",
  "__c=cat; \"$__c\" secret.dat": "prompt",
  "__c=chmod; \"$__c\" 777 shared.dat": "prompt",
  "__c=rm; \"$__c\" protected.dat": "prompt",
  "awk 'BEGIN{system(\"cat secret.dat\")}'": "prompt",
  "awk 'BEGIN{system(\"chmod 777 shared.dat\")}'": "prompt",
  "awk 'BEGIN{system(\"rm protected.dat\")}'": "prompt",
  "c''at secret.dat": "prompt",
  "c''hmod 777 shared.dat": "prompt",
  "c\\\nat secret.dat": "prompt",
  "c\\\nhmod 777 shared.dat": "prompt",
  "cat secret.dat": "prompt",
  "cat${IFS}secret.dat": "prompt",
  "chmod 777 shared.dat": "prompt",
  "chmod a+rwx shared.dat": "prompt",
  "chmod${IFS}777${IFS}shared.dat": "prompt",
  "command cat secret.dat": "prompt",
  "command chmod 777 shared.dat": "prompt",
  "command rm protected.dat": "prompt",
  "echo Y2F0IHNlY3JldC5kYXQ= | base64 -d | sh": "prompt",
  "echo Y2htb2QgNzc3IHNoYXJlZC5kYXQ= | base64 -d | sh": "prompt",
  "echo cm0gcHJvdGVjdGVkLmRhdA== | base64 -d | sh": "prompt",
  "echo hi": "allow",
  "env cat secret.dat": "prompt",
  "env chmod 777 shared.dat": "prompt",
  "env rm protected.dat": "prompt",
  "eval \"cat secret.dat\"": "prompt",
  "eval \"chmod 777 shared.dat\"": "prompt",
  "eval \"rm protected.dat\"": "prompt",
  "find . -maxdepth 0 -exec cat secret.dat \";\"": "allow",
  "find . -maxdepth 0 -exec cat secret.dat ';'": "allow",
  "find . -maxdepth 0 -exec cat secret.dat +": "allow",
  "find . -maxdepth 0 -exec cat secret.dat \\;": "prompt",
  "find . -maxdepth 0 -exec chmod 777 shared.dat \";\"": "allow",
  "find . -maxdepth 0 -exec chmod 777 shared.dat ';'": "allow",
  "find . -maxdepth 0 -exec chmod 777 shared.dat +": "allow",
  "find . -maxdepth 0 -exec chmod 777 shared.dat \\;": "prompt",
  "find . -maxdepth 0 -exec rm protected.dat \";\"": "allow",
  "find . -maxdepth 0 -exec rm protected.dat ';'": "allow",
  "find . -maxdepth 0 -exec rm protected.dat +": "allow",
  "find . -maxdepth 0 -exec rm protected.dat \\;": "prompt",
  "find . -maxdepth 0 -exec sh -c 'cat secret.dat' \\;": "prompt",
  "find . -maxdepth 0 -exec sh -c 'chmod 777 shared.dat' \\;": "prompt",
  "find . -maxdepth 0 -exec sh -c 'rm protected.dat' \\;": "prompt",
  "find . -maxdepth 0 -execdir cat secret.dat \\;": "prompt",
  "find . -maxdepth 0 -execdir chmod 777 shared.dat \\;": "prompt",
  "find . -maxdepth 0 -execdir rm protected.dat \\;": "prompt",
  "find . -name protected.dat -delete": "allow",
  "find . -name x": "allow",
  "git -c alias.gbb='!cat secret.dat' gbb": "allow",
  "git -c alias.gbb='!chmod 777 shared.dat' gbb": "allow",
  "git -c alias.gbb='!rm protected.dat' gbb": "allow",
  "git status": "allow",
  "grep '' secret.dat": "prompt",
  "head -c 10000 secret.dat": "prompt",
  "ls": "allow",
  "ls && rm notes.txt": "prompt",
  "nice cat secret.dat": "prompt",
  "nice chmod 777 shared.dat": "prompt",
  "nice rm protected.dat": "prompt",
  "printf %s Y2F0IHNlY3JldC5kYXQ= | base64 -d > s.sh; sh s.sh": "prompt",
  "printf %s Y2htb2QgNzc3IHNoYXJlZC5kYXQ= | base64 -d > s.sh; sh s.sh": "prompt",
  "printf %s cm0gcHJvdGVjdGVkLmRhdA== | base64 -d > s.sh; sh s.sh": "prompt",
  "printf '%s\\n' \"cat secret.dat\" > s.sh; . ./s.sh": "prompt",
  "printf '%s\\n' \"cat secret.dat\" > s.sh; sh s.sh": "prompt",
  "printf '%s\\n' \"chmod 777 shared.dat\" > s.sh; . ./s.sh": "prompt",
  "printf '%s\\n' \"chmod 777 shared.dat\" > s.sh; sh s.sh": "prompt",
  "printf '%s\\n' \"rm protected.dat\" > s.sh; . ./s.sh": "prompt",
  "printf '%s\\n' \"rm protected.dat\" > s.sh; sh s.sh": "prompt",
  "printf '%s\\n' 777 shared.dat | xargs chmod": "prompt",
  "printf '%s\\n' protected.dat | xargs rm": "prompt",
  "printf '%s\\n' secret.dat | xargs cat": "prompt",
  "r''m protected.dat": "prompt",
  "r\\\nm protected.dat": "prompt",
  "rm notes.txt": "prompt",
  "rm protected.dat": "prompt",
  "rm${IFS}protected.dat": "prompt",
  "sed '' secret.dat": "prompt",
  "sh <<'GBB_EOF'\ncat secret.dat\nGBB_EOF": "prompt",
  "sh <<'GBB_EOF'\nchmod 777 shared.dat\nGBB_EOF": "prompt",
  "sh <<'GBB_EOF'\nrm protected.dat\nGBB_EOF": "prompt",
  "timeout 5 cat secret.dat": "prompt",
  "timeout 5 chmod 777 shared.dat": "prompt",
  "timeout 5 rm protected.dat": "prompt",
  "true; cat secret.dat": "prompt",
  "true; chmod 777 shared.dat": "prompt",
  "true; rm protected.dat": "prompt",
  "unlink protected.dat": "prompt"
}
